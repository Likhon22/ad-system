{
    "swagger": "2.0",
    "info": {
        "description": "Authentication service for the Ad System",
        "title": "Auth Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:5000",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Login a user account with email, password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login a new user",
                "parameters": [
                    {
                        "description": "Login payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_inbound_http_handler.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.Response-github_com_likhon22_ad-system_auth-service_internal_domain_User"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Creates a new user account with email, password and role",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Register payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_inbound_http_handler.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.Response-github_com_likhon22_ad-system_auth-service_internal_domain_User"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_likhon22_ad-system_auth-service_internal_domain.Role": {
            "type": "string",
            "enum": [
                "advertiser",
                "publisher",
                "admin"
            ],
            "x-enum-varnames": [
                "RoleAdvertiser",
                "RolePublisher",
                "RoleAdmin"
            ]
        },
        "github_com_likhon22_ad-system_auth-service_internal_domain.Status": {
            "type": "string",
            "enum": [
                "active",
                "suspended"
            ],
            "x-enum-varnames": [
                "StatusActive",
                "StatusSuspended"
            ]
        },
        "github_com_likhon22_ad-system_auth-service_internal_domain.User": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "passwordHash": {
                    "type": "string"
                },
                "role": {
                    "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_domain.Role"
                },
                "status": {
                    "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_domain.Status"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "github_com_likhon22_ad-system_auth-service_internal_utils.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "github_com_likhon22_ad-system_auth-service_internal_utils.Response-github_com_likhon22_ad-system_auth-service_internal_domain_User": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/github_com_likhon22_ad-system_auth-service_internal_domain.User"
                },
                "message": {
                    "type": "string"
                },
                "success": {
                    "type": "boolean"
                }
            }
        },
        "internal_adapter_inbound_http_handler.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                }
            }
        },
        "internal_adapter_inbound_http_handler.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "advertiser",
                        "publisher"
                    ]
                }
            }
        }
    }
}